# ==========================================
# TraceGuard 2.0 — Git Ignore Configuration
# Protects secrets, build outputs, and dependencies
# ==========================================

# ── 1. Secrets & Environment Files ───────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# ── 2. Dependencies & Package Managers ───
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 3. Next.js Build Outputs ──────────────
.next/
out/
build/
dist/

# ── 4. Python Environment & Caches ────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
.pytest_cache/
.coverage
htmlcov/

# ── 5. System & IDE Files ────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── 6. Logs & Temp Artifacts ─────────────
*.log
logs/
*.tmp
*.temp
