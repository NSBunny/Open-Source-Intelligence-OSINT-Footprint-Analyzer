# TraceGuard 2.0 Engine Environment Configuration Template
# Copy this file to .env and fill in your actual API keys.

# AI Provider Configuration (groq | gemini | openai)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# OSINT & Threat Intel API Keys
LEAKCHECK_API_KEY=your_leakcheck_api_key_here
SHODAN_API_KEY=
HUNTER_API_KEY=

# Set to true for mock data fallback mode, or false for live API scanning
USE_MOCK_DATA=false

# Server Host & Port
PYTHON_ENGINE_HOST=0.0.0.0
PYTHON_ENGINE_PORT=8000
